# =============================
# SERVER
# =============================
PORT=3001
# Máximo de requests por IP cada 15 min (rate limiter OWASP).
# Producción: 300 por defecto. Dev: 1000. Se puede ajustar con RATE_LIMIT_MAX.
RATE_LIMIT_MAX=1000

# =============================
# DATA STORE
# Modo dev: usa store local (archivos JSON en api/.data).
# ProducciÃ³n: agrega FIREBASE_SERVICE_ACCOUNT (JSON base64) o
# GOOGLE_APPLICATION_CREDENTIALS para usar Firestore real.
# =============================
STORE_MODE=file
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# =============================
# AUTH
# Modo dev: permite header X-Dev-User (solo si AUTH_MODE=dev).
# ProducciÃ³n: AUTH_MODE=firebase y tokens reales de Firebase Auth.
# FIREBASE_API_KEY: key web de Firebase (frontend), se usa solo en el cliente.
# =============================
AUTH_MODE=firebase
FIREBASE_API_KEY=

# =============================
# CORS
# Origen del frontend en dev y producciÃ³n.
# =============================
CORS_ORIGIN=http://localhost:5173

# =============================
# IA (Groq) â€” Tutor IA (V3)
# Sin GROQ_API_KEY el servidor responde con un mock en dev (no gasta tokens).
# âš ï¸ Reemplaza con tu propia key (https://console.groq.com). No uses valores reales aquÃ­.
# =============================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# =============================
# PAGOS (Hotmart) â€” V4/V7
# Sin credenciales, el webhook funciona en modo dev (AUTH_MODE=dev) sin firma.
# V7: checkout con custom=userId, planes mensual/anual, renovaciones.
# =============================
HOTMART_WEBHOOK_SECRET=
HOTMART_WEBHOOK_TOKEN=
HOTMART_CHECKOUT_URL=
HOTMART_CHECKOUT_URL_MONTHLY=
HOTMART_CHECKOUT_URL_ANNUAL=
HOTMART_PRODUCT_ANNUAL_ID=
HOTMART_SUCCESS_URL=
HOTMART_CANCEL_URL=
PRICE_MONTHLY_USD=15
PRICE_ANNUAL_USD=99

# =============================
# ADMIN / DASHBOARD
# =============================
ADMIN_USER_ID=

# =============================
# FRONTEND
# Ruta base de los assets de contenido (JSON del curriculum).
# =============================
CONTENT_DIR=../content
