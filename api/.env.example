# =============================
# SERVER
# =============================
PORT=3001
# M�ximo de requests por IP cada 15 min (rate limiter OWASP).
# Producci�n: 300 por defecto. Dev: 1000. Se puede ajustar con RATE_LIMIT_MAX.
RATE_LIMIT_MAX=1000

# =============================
# DATA STORE
# Modo dev: usa store local (archivos JSON en api/.data).
# Producción: agrega FIREBASE_SERVICE_ACCOUNT (JSON base64) o
# GOOGLE_APPLICATION_CREDENTIALS para usar Firestore real.
# =============================
STORE_MODE=file
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# =============================
# AUTH
# Modo dev: permite header X-Dev-User (solo si AUTH_MODE=dev).
# Producción: AUTH_MODE=firebase y tokens reales de Firebase Auth.
# FIREBASE_API_KEY: key web de Firebase (frontend), se usa solo en el cliente.
# =============================
AUTH_MODE=firebase
FIREBASE_API_KEY=

# =============================
# CORS
# Origen del frontend en dev y producción.
# =============================
CORS_ORIGIN=http://localhost:5173,https://ingresosdigitalesit.com

# =============================
# IA (Groq) — Tutor IA (V3)
# Sin GROQ_API_KEY el servidor responde con un mock en dev (no gasta tokens).
# ⚠️ Reemplaza con tu propia key (https://console.groq.com). No uses valores reales aquí.
# =============================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# =============================
# PAGOS (Hotmart) — V4/V7
# Sin credenciales, el webhook funciona en modo dev (AUTH_MODE=dev) sin firma.
# V7: checkout con custom=userId, planes mensual/anual, renovaciones.
# HOTMART_PRODUCT_IDS (opcional, coma): si se define, SOLO se procesan eventos
# de esos product ids — evita que otros productos de tu cuenta Hotmart activen accesos.
# =============================
HOTMART_WEBHOOK_SECRET=
HOTMART_WEBHOOK_TOKEN=
HOTMART_CHECKOUT_URL=
HOTMART_CHECKOUT_URL_MONTHLY=
HOTMART_CHECKOUT_URL_ANNUAL=
HOTMART_PRODUCT_ANNUAL_ID=
HOTMART_PRODUCT_IDS=
HOTMART_SUCCESS_URL=
HOTMART_CANCEL_URL=
PRICE_MONTHLY_USD=4.99
PRICE_ANNUAL_USD=39.99

# =============================
# ACTIVACIÓN DE CUENTAS (compra externa → Hotmart → webhook)
# URL del frontend donde aterriza el cliente tras crear su contraseña en la
# página de restablecimiento de Firebase. El dominio debe estar autorizado en
# Firebase Console → Authentication → Settings → Authorized domains.
# Local/E2E: http://localhost:5173/activar  (localhost siempre está autorizado)
# =============================
ACTIVATION_URL=https://www.ingresosdigitalesit.com/appingles/activar

# =============================
# CORREO TRANSACCIONAL (SMTP)
# Remitente oficial: acceso@ingresosdigitalesit.com (Hostinger).
# Si MAIL_HOST/MAIL_USER/MAIL_PASSWORD están vacíos, la API funciona en modo
# dry-run: los emails NO se envían; quedan registrados en 'mailOutbox' y en logs.
# Nunca exponer estas variables al frontend.
# =============================
MAIL_FROM=acceso@ingresosdigitalesit.com
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=acceso@ingresosdigitalesit.com
MAIL_PASSWORD=
SUPPORT_EMAIL=acceso@ingresosdigitalesit.com
APP_PUBLIC_URL=https://www.ingresosdigitalesit.com
RESEND_MAX_PER_HOUR=10

# =============================
# ADMIN / DASHBOARD
# =============================
ADMIN_USER_ID=

# =============================
# FRONTEND
# Ruta base de los assets de contenido (JSON del curriculum).
# =============================
CONTENT_DIR=../content
