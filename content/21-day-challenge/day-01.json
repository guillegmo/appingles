      "I am Maria.",
      "You are from Mexico.",
      "She is my friend.",
      "They are students.",
      "I am not tired.",
      "Are you a student?"
    ],
    "commonMistakes": [
      "I is → I am",
      "She are → She is",
      "I am from → NO 'I am from of' (sin 'of')"
    ]
  },
