  "lesson": {
    "title": "Like / don't like + sustantivo o -ing",
    "rule": "Para gustos se usa 'like' + sustantivo (I like coffee) o + verbo en -ing (I like listening to music). Negativo: don't like. Pregunta: Do you like...? Con he/she/it se añade -s: She likes. Para amor fuerte: I love.",
    "examples": [
      "I like music.",
      "I like reading.",
      "I don't like coffee.",
      "She likes sports.",
      "Do you like pizza?",
      "I love travelling."
    ],
    "commonMistakes": [
      "I like play → I like playing / I like to play",
      "I don't like pizza? (afirmativo) → I don't like pizza (punto)",
      "Do you like pizza? → NO 'You like pizza?'"
    ]
  },
