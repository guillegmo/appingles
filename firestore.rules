rules_version = '2';

// AppIngles: todo acceso a datos ocurre a través de la API (Admin SDK),
// que ignora estas reglas. Bloqueamos cualquier acceso directo desde
// clientes para impedir lecturas/escrituras fuera del backend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
